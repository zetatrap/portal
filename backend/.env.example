# Variables de Entorno - Backend

# Puerto del servidor
PORT=5000

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=laordencrew_db

# JWT Secret (cambiar en producción)
JWT_SECRET=laordencrew_super_secret_key_2026_change_in_production

# Entorno
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Bcrypt
BCRYPT_ROUNDS=10

# Email (configurar con tu servicio de email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_contraseña_de_aplicación
EMAIL_FROM=noreply@laordencrew.com
